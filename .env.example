# Banco de dados MySQL (Railway plugin MySQL fornece essas variáveis automaticamente)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=preconsumo

# Autenticação
JWT_SECRET=troque-isto-por-um-segredo-aleatorio-forte

# URL pública do app (usada para CORS em produção)
APP_URL=https://preconsumo.samantagomes.com.br

# Porta do servidor
PORT=3001
NODE_ENV=production

# Usados apenas pelo script create-admin
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=troque-esta-senha
