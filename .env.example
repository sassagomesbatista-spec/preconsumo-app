# Banco de dados MySQL (Railway plugin MySQL fornece essas variáveis automaticamente)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=preconsumo

# Autenticação
JWT_SECRET=troque-isto-por-um-segredo-aleatorio-forte

# URL pública do app (usada para CORS em produção)
APP_URL=https://preconsumo.samantagomes.com.br

# Porta do servidor
PORT=3001
NODE_ENV=production

# Usados apenas pelo script create-admin
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=troque-esta-senha

# Ponte com o ERP (erp-comissao) — usada nas duas direções: pra buscar/vincular
# um pedido daqui (erpBridge.ts) e pro ERP puxar de volta a grade do projeto na
# hora de criar a Ordem de Produção (server/routes/external-api.ts). A chave é
# uma só, gerada em Configurações → Integração Préconsumo do lado do ERP —
# cole aqui o mesmo valor exato.
ERP_API_URL=https://SEU-DOMINIO-DO-ERP
ERP_API_KEY=cole-aqui-a-mesma-chave-gerada-no-erp
